APP_NAME="PBL Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — values match the `db` service in docker-compose.yml
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pjbl
DB_USERNAME=pjbl
DB_PASSWORD=password

# SESSION_DRIVER options (performance order: file > database > redis):
#   file     — fastest for single-server; no DB hit per request
#   database — default; one SELECT+UPDATE per request on the sessions table
#   redis    — best for multi-server; requires Redis in docker-compose
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — defaults route to the bundled MailHog container.
# Open http://localhost:8025 to inspect outgoing email.
# To send real email, swap MAIL_HOST/PORT/USERNAME/PASSWORD for your SMTP.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@pbl.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Jitsi Meet (JaaS / 8x8.vc, JWT-authenticated) — placeholders only.
# Video conference feature stays disabled until real credentials are filled in.
# Provision the private key file at JITSI_PRIVATE_KEY_PATH manually.
# ---------------------------------------------------------------------------
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=
JITSI_KID=
JITSI_PRIVATE_KEY_PATH=storage/app/private/jaas-private-key.pk

# ---------------------------------------------------------------------------
# Code execution sandbox — points at the bundled Piston container.
# ---------------------------------------------------------------------------
PISTON_URL=http://piston:2000/api/v2
# PISTON_TIMEOUT=10

# ---------------------------------------------------------------------------
# Web Push (VAPID) — placeholders. Generate with `php artisan webpush:vapid`.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
